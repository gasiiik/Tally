<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Tally.Views.LoginView"
             xmlns:vm="using:Tally.ViewModels"
             x:DataType="vm:LoginViewModel"

             >
 




<StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Přihlášení" HorizontalAlignment="Center"/>
    <TextBlock Text="{Binding Status}" HorizontalAlignment="Center"/>
    
    <TextBox Text="{Binding UsernameInput}" Watermark="Napiš své jméno" Width="200"/>
    <TextBox Text="{Binding PasswordInput}" Watermark="Napiš své heslo" Width="200" PasswordChar="•"/>
    
    <Button Content="Přihlásit se" Command="{Binding PrihlasitCommand}" HorizontalAlignment="Center"/>
</StackPanel>
</UserControl>
